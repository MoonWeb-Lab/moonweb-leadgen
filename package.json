{
  "name": "moonweb-leadgen",
  "version": "1.0.0",
  "description": "Telegram Mini App & Lead Generation System for MoonWeb Lab",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "cmd /c \"cd apps/backend && npm run dev\"",
    "dev:webapp": "cmd /c \"cd apps/webapp && npm run dev\"",
    "dev:worker": "cmd /c \"cd apps/worker && npm run dev\"",
    "seed": "cmd /c \"cd apps/worker && npm run seed\"",
    "parse": "cmd /c \"cd apps/worker && npm run parse\"",
    "sync": "cmd /c \"cd apps/worker && npm run sync\"",
    "instagram:outreach": "cmd /c \"cd apps/worker && npm run instagram:outreach\"",
    "build:all": "cmd /c \"cd apps/backend && npm run build && cd ../webapp && npm run build\""
  },
  "keywords": ["telegram-mini-app", "lead-generation", "moonweb-lab", "fastify", "react"],
  "author": "MoonWeb Lab",
  "license": "MIT"
}
